# 复制为 .env 后填写 VictoriaLogs 所在机器地址。
# copy .env.example .env

VECTOR_IMAGE=timberio/vector:0.49.0-debian
TZ=Asia/Shanghai

# ---------- 远端 VictoriaLogs（业务机必须能访问 :9428） ----------
# 本机联调（Docker Desktop / 加了 host-gateway 的 Linux）：
VL_HOST=host.docker.internal
# 生产：改成中心机 IP 或域名，例如
# VL_HOST=10.0.1.20
VL_HTTP_PORT=9428

# 必须和中心机 .env 里的 VL_AUTH_* 一致，否则写入会被 401
VL_AUTH_USERNAME=admin
VL_AUTH_PASSWORD=changeme

# Elasticsearch bulk 入口由 compose 用 VL_HOST + VL_HTTP_PORT 拼出来，一般不用改。

# ---------- 采集目录（宿主机路径） ----------
# demo：挂到容器 /var/log/app
LOG_HOST_DIR=./logs
# java-admin 全量日志：挂到容器 /var/log/java-admin
JAVA_ADMIN_LOG_DIR=/opt/java-admin/logs

# Vector API（可选，本机排查用）。避开 Doris 栈 Vector 的 8686。
VECTOR_API_PORT=8687
