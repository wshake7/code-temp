# 复制为 .env 后按需修改。默认值已可本地启动。
# copy .env.example .env

# ---------- 镜像 ----------
# 与官方 Quick Start / Docker demo 对齐：https://docs.victoriametrics.com/victorialogs/quickstart/
VICTORIALOGS_IMAGE=victoriametrics/victoria-logs:v1.52.0

# ---------- 端口（宿主机） ----------
# 9428：写入 + LogsQL + 内置 UI /select/vmui/（业务机 Vector 必须能访问）
VL_HTTP_PORT=9428

# ---------- VMUI / HTTP Basic Auth ----------
# 进 http://<中心机>:9428/select/vmui/ 会要账号。业务机 Vector 必须填同一套。
# 生产务必改掉默认密码。密码里不要用 $，compose 会当变量展开。
VL_AUTH_USERNAME=admin
VL_AUTH_PASSWORD=changeme

# ---------- 存储 ----------
# 默认保留 7 天，与 VictoriaLogs 默认值一致
VL_RETENTION=7d

# ---------- 内存（mem_limit 硬顶；GOMEMLIMIT 约 85%） ----------
VL_MEM_LIMIT=768m
VL_GOMEMLIMIT=650MiB

# ---------- 时区 ----------
TZ=Asia/Shanghai
