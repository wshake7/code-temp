# 复制为 .env 后填写 Doris 所在机器地址。
# cp .env.example .env

VECTOR_IMAGE=timberio/vector:0.49.0-debian
TZ=Asia/Shanghai

# ---------- 远端 Doris BE（业务机必须能访问） ----------
# 本机联调（Docker Desktop / 加了 host-gateway 的 Linux）：
DORIS_BE_HOST=host.docker.internal
# 生产：改成 Doris 机器 IP 或域名，例如
# DORIS_BE_HOST=10.0.1.20
DORIS_BE_HTTP_PORT=8040
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DATABASE=log_db
DORIS_TABLE=doris_log

# ---------- 采集目录（宿主机路径，挂到容器 /var/log/app） ----------
# 生产示例：LOG_HOST_DIR=/var/log/myapp
LOG_HOST_DIR=./logs

# Vector API（可选，本机排查用）
VECTOR_API_PORT=8686

# ---------- 内存 ----------
VECTOR_MEM_LIMIT=256m
LOG_GENERATOR_MEM_LIMIT=64m
