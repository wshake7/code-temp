# 复制为 .env 后按需修改。默认值已可本地启动。
# cp .env.example .env

# ---------- 镜像 ----------
# 官方快速入门默认 4.0.1；对应 apache/doris:fe-4.0.1 / be-4.0.1
DORIS_VERSION=4.0.1
GRAFANA_IMAGE=grafana/grafana:11.6.3
MYSQL_CLIENT_IMAGE=mysql:8.4

# ---------- 端口（宿主机） ----------
FE_HTTP_PORT=8030
FE_MYSQL_PORT=9030
FE_EDIT_PORT=9010
BE_HTTP_PORT=8040
BE_HEARTBEAT_PORT=9050
GRAFANA_PORT=4300

# ---------- 账号（仅本地 demo） ----------
# Doris 官方镜像默认 root 空密码
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DATABASE=log_db
DORIS_TABLE=doris_log

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---------- 内存（FE 堆已是 2g；BE 脚本把进程预算压到 3G） ----------
DORIS_FE_MEM_LIMIT=3072m
DORIS_BE_MEM_LIMIT=4096m
DORIS_INIT_MEM_LIMIT=256m
GRAFANA_MEM_LIMIT=256m

# ---------- 时区 ----------
TZ=Asia/Shanghai
