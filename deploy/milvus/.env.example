# 复制为 .env 后按需修改。默认值已可本地启动。
# copy .env.example .env

# ---------- 镜像 ----------
# 对齐官方 standalone compose（仓库 master）：
# https://raw.githubusercontent.com/milvus-io/milvus/master/deployments/docker/standalone/docker-compose.yml
# 文档：https://milvus.io/docs/install_standalone-docker-compose.md
MILVUS_IMAGE=milvusdb/milvus:v3.0.0
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.25
MINIO_IMAGE=minio/minio:RELEASE.2024-05-28T17-19-04Z

# ---------- 端口（宿主机） ----------
# 19530：gRPC / 客户端 URI（pymilvus 默认）
# 9091：healthz + WebUI /webui/
# MinIO 控制台默认改到 19000/19001，避开常见 9000 占用；容器内仍是 9000
MILVUS_GRPC_PORT=19530
MILVUS_HTTP_PORT=9091
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# ---------- MinIO（仅本栈内部；官方默认账号） ----------
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---------- 内存（mem_limit 硬顶） ----------
MILVUS_MEM_LIMIT=2g
ETCD_MEM_LIMIT=256m
MINIO_MEM_LIMIT=256m

# ---------- 时区 ----------
TZ=Asia/Shanghai
