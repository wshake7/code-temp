# 复制为 .env 后按需修改。默认值已可本地启动。
# copy .env.example .env

# ---------- 镜像 ----------
# 与官方 Quick Start 对齐：https://qdrant.tech/documentation/quickstart/
# 版本钉死，避免 latest 漂移。发布页：https://github.com/qdrant/qdrant/releases
QDRANT_IMAGE=qdrant/qdrant:v1.19.0

# ---------- 端口（宿主机） ----------
# 6333：REST + Dashboard /dashboard + /readyz
# 6334：gRPC（Rust/Java/.NET/Go 客户端常用）
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ---------- API Key ----------
# 自建默认无鉴权。本栈默认打开 admin key，请求头：api-key: <值>
# 生产务必改掉默认密码。密码里不要用 $，compose 会当变量展开。
# 文档：https://qdrant.tech/documentation/security/
QDRANT_API_KEY=changeme

# ---------- 内存（mem_limit 硬顶） ----------
QDRANT_MEM_LIMIT=1g

# ---------- 时区 ----------
TZ=Asia/Shanghai
