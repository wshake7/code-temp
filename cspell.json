{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-US",
  "allowCompoundWords": true,
  "words": [
    "antd",
    "antdv",
    "antdv-next",
    "commitlint",
    "commitlintrc",
    "DictData",
    "DictTagType",
    "DictType",
    "Dskip",
    "echarts",
    "h3",
    "javac",
    "lbug",
    "lefthook",
    "LiteralUnion",
    "mockjs",
    "nitro",
    "nitropack",
    "oxfmt",
    "oxlint",
    "pnpm",
    "PresetColorType",
    "PresetStatusColorType",
    "pro-workflow",
    "rolldown",
    "rollup",
    "smart-search",
    "tagType",
    "trae",
    "trellis",
    "trellis-demo",
    "tsdown",
    "turbo",
    "turborepo",
    "unocss",
    "vadmin",
    "vben",
    "vbenjs",
    "vite",
    "vite-plus",
    "vitejs",
    "vitest",
    "vueuse",
    "vxe-table",
    "wshake",
    "zhipu"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/output/**",
    "**/coverage/**",
    "**/.nitro/**",
    "**/.turbo/**",
    "**/*.log",
    "**/pnpm-lock.yaml",
    "**/cspell.json",
    "apps/vue-vben-admin",
    "apps/vue-vben-admin/**",
    "apps/react-admin",
    "apps/react-admin/**"
  ]
}
