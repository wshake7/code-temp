# backend-mock 开发侧配置（nitro dev 自动加载）
# 会话语义对齐 sa-token 约定；改后需重启 mock 生效

# 会话超时（秒）；每次合法请求滑动续期
# 默认 2592000 = 30 天
AUTH_TOKEN_TIMEOUT_SECONDS=2592000

# 是否允许多端登录（true=同账号可多会话并存）
AUTH_IS_CONCURRENT=true

# 同账号是否共享同一 token（false=每次登录新 token）
AUTH_IS_SHARE=false

# ---------- 鉴权模式 ----------
# mock    = 纯 mock：校验本地会话 token（默认）
# mixture = 与 java 交叉：不校验 token，业务用 AUTH_JAVA_USER_FALLBACK 用户做 RBAC
#           （不再请求 java /user/info，避免 Encrypt 缺头报错）
AUTH_MODE=mixture

# mixture 下 RBAC 使用的 mock 用户（默认 root）
AUTH_JAVA_USER_FALLBACK=root

# （可选）mock 模式下显式配置后，才对未知 token 调 java 内省；默认关闭
# AUTH_JAVA_INTROSPECT_URL=http://localhost:4080/api/user/info
# AUTH_JAVA_INTROSPECT_TIMEOUT_MS=3000

# ---------- 请求安全协议（与 Java app.security 对齐，默认全开）----------
SECURITY_TIMESTAMP_ENABLED=true
SECURITY_TIMESTAMP_EXPIRE_MS=300000
SECURITY_ENCRYPT_ENABLED=true
SECURITY_NONCE_ENABLED=true
# 0 = 使用 2 × SECURITY_TIMESTAMP_EXPIRE_MS
SECURITY_NONCE_EXPIRE_MS=0
SECURITY_SIGN_ENABLED=true
SECURITY_LANGUAGE_ENABLED=true

# （可选）从 java dev 接口拉**全局** RSA 密钥对（登录前公钥对齐）；未填则不访问
# mixture + Encrypt 开时建议配置，例如：
SECURITY_JAVA_KEY_PAIR_URL=http://localhost:4080/api/encrypt/dev/key-pair
SECURITY_JAVA_KEY_PAIR_TIMEOUT_MS=3000

# （可选）从 java dev 按 Bearer 拉**会话专属**密钥（登录后前端用会话 publicKey 加密时必需）
# 未配置则仅本地 mock 登录会话钥可用；hybrid 登录走 java 时请配置：
SECURITY_JAVA_SESSION_KEY_URL=http://localhost:4080/api/encrypt/dev/session-key
SECURITY_JAVA_SESSION_KEY_TIMEOUT_MS=3000

# 可选：注入固定 RSA 密钥（PUBLIC 为 SPKI base64 或 PEM；PRIVATE 为 PKCS#8 PEM）
# 设置后不再从 SECURITY_JAVA_KEY_PAIR_URL 拉取（不影响 SESSION_KEY 拉取）
# SECURITY_RSA_PUBLIC_KEY=
# SECURITY_RSA_PRIVATE_KEY=
