{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "enabledMcpjsonServers": [
    "playwright",
    "codebase-memory-mcp"
  ],
  "enabledPlugins": {
    "claude-hud@claude-hud": true,
    "ponytail@ponytail": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/crg-hook.py update",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/crg-hook.py status",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
